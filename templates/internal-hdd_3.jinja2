<!DOCTYPE html>
<html lang="zh-Hant" data-theme="light">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover">
    <title>內接硬碟 HDD 比價表｜每 TB 價格排行</title>

    <!-- 字型 -->
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&family=Noto+Sans+TC:wght@400;500;700&display=swap" rel="stylesheet">

    <!-- 在畫面繪製前先套用主題，避免閃白 -->
    <script>
        (function () {
            try {
                var saved = localStorage.getItem('hdd-theme');
                var dark = window.matchMedia && window.matchMedia('(prefers-color-scheme: dark)').matches;
                document.documentElement.setAttribute('data-theme', saved || (dark ? 'dark' : 'light'));
            } catch (e) {}
        })();
    </script>

    <style>
        :root {
            color-scheme: light;
            --bg: #f4f6fb;
            --surface: #ffffff;
            --surface-2: #f8fafc;
            --border: #e3e8f0;
            --text: #0f172a;
            --text-2: #475569;
            --text-3: #94a3b8;
            --primary: #4f46e5;
            --primary-soft: #eef2ff;
            --primary-text: #ffffff;
            --good: #059669;
            --good-soft: #d1fae5;
            --warn: #d97706;
            --warn-soft: #fef3c7;
            --danger: #e11d48;
            --row-hover: #f5f7ff;
            --shadow: 0 1px 2px rgba(15, 23, 42, .05), 0 4px 16px rgba(15, 23, 42, .06);
            --radius: 14px;
            --font: "Inter", "Noto Sans TC", system-ui, -apple-system, "Segoe UI", "Microsoft JhengHei", sans-serif;
        }

        [data-theme="dark"] {
            color-scheme: dark;
            --bg: #0b1020;
            --surface: #121a2f;
            --surface-2: #0f1627;
            --border: #232e4a;
            --text: #e8ecf8;
            --text-2: #a5b0cc;
            --text-3: #6b7796;
            --primary: #818cf8;
            --primary-soft: #1d2447;
            --primary-text: #0b1020;
            --good: #34d399;
            --good-soft: #0f3a2e;
            --warn: #fbbf24;
            --warn-soft: #3b2f0f;
            --danger: #fb7185;
            --row-hover: #18213b;
            --shadow: 0 1px 2px rgba(0, 0, 0, .4), 0 8px 24px rgba(0, 0, 0, .35);
        }

        * { box-sizing: border-box; }

        html { scroll-behavior: smooth; }

        body {
            margin: 0;
            font-family: var(--font);
            background: var(--bg);
            color: var(--text);
            line-height: 1.5;
            -webkit-font-smoothing: antialiased;
            transition: background .25s, color .25s;
        }

        button, input, select { font: inherit; color: inherit; }
        button { cursor: pointer; }

        :focus-visible {
            outline: 2px solid var(--primary);
            outline-offset: 2px;
            border-radius: 6px;
        }

        .container {
            max-width: 1360px;
            margin: 0 auto;
            padding: 24px 20px 80px;
        }

        /* ---------- Header ---------- */
        .hero {
            display: flex;
            gap: 16px;
            align-items: flex-start;
            justify-content: space-between;
            flex-wrap: wrap;
            margin-bottom: 22px;
        }

        .hero h1 {
            margin: 0 0 6px;
            font-size: clamp(1.5rem, 3.2vw, 2.1rem);
            letter-spacing: -.02em;
            display: flex;
            align-items: center;
            gap: 12px;
        }

        .hero h1 .logo {
            width: 42px;
            height: 42px;
            border-radius: 12px;
            display: grid;
            place-items: center;
            background: linear-gradient(135deg, var(--primary), #a78bfa);
            color: #fff;
            flex-shrink: 0;
        }

        .meta {
            display: flex;
            flex-wrap: wrap;
            gap: 8px 16px;
            color: var(--text-2);
            font-size: .88rem;
        }

        .meta span { display: inline-flex; align-items: center; gap: 6px; }

        .dot {
            width: 8px; height: 8px; border-radius: 50%;
            background: var(--good);
            box-shadow: 0 0 0 4px var(--good-soft);
        }

        .icon-btn {
            width: 42px; height: 42px;
            border-radius: 12px;
            border: 1px solid var(--border);
            background: var(--surface);
            display: grid; place-items: center;
            box-shadow: var(--shadow);
            transition: transform .15s, background .2s;
        }
        .icon-btn:hover { transform: translateY(-1px); background: var(--primary-soft); }
        .icon-btn svg { width: 20px; height: 20px; }
        [data-theme="dark"] .icon-sun { display: block; }
        [data-theme="dark"] .icon-moon { display: none; }
        [data-theme="light"] .icon-sun { display: none; }
        [data-theme="light"] .icon-moon { display: block; }

        /* ---------- Stats ---------- */
        .stats {
            display: grid;
            grid-template-columns: repeat(auto-fit, minmax(210px, 1fr));
            gap: 14px;
            margin-bottom: 18px;
        }

        .stat {
            background: var(--surface);
            border: 1px solid var(--border);
            border-radius: var(--radius);
            padding: 16px 18px;
            box-shadow: var(--shadow);
            min-width: 0;
        }

        .stat .label { font-size: .8rem; color: var(--text-2); margin-bottom: 4px; }
        .stat .value { font-size: 1.55rem; font-weight: 700; letter-spacing: -.02em; font-variant-numeric: tabular-nums; }
        .stat .value small { font-size: .85rem; font-weight: 500; color: var(--text-2); margin-left: 4px; }
        .stat .hint {
            font-size: .78rem; color: var(--text-3);
            white-space: nowrap; overflow: hidden; text-overflow: ellipsis;
            margin-top: 2px;
        }
        .stat.accent .value { color: var(--good); }

        /* ---------- Toolbar ---------- */
        .card {
            background: var(--surface);
            border: 1px solid var(--border);
            border-radius: var(--radius);
            box-shadow: var(--shadow);
        }

        .toolbar { padding: 16px; margin-bottom: 14px; }

        .toolbar-row {
            display: flex;
            gap: 10px;
            flex-wrap: wrap;
            align-items: center;
        }

        .search {
            position: relative;
            flex: 1 1 280px;
            min-width: 220px;
        }
        .search svg {
            position: absolute; left: 12px; top: 50%;
            transform: translateY(-50%);
            width: 18px; height: 18px; color: var(--text-3);
            pointer-events: none;
        }
        .search input {
            width: 100%;
            padding: 11px 44px 11px 38px;
            border-radius: 10px;
            border: 1px solid var(--border);
            background: var(--surface-2);
            transition: border-color .2s, box-shadow .2s;
        }
        .search input:focus {
            outline: none;
            border-color: var(--primary);
            box-shadow: 0 0 0 3px var(--primary-soft);
        }
        .search kbd {
            position: absolute; right: 10px; top: 50%;
            transform: translateY(-50%);
            font-size: .72rem; padding: 1px 7px;
            border: 1px solid var(--border); border-radius: 6px;
            color: var(--text-3); background: var(--surface);
        }

        .btn {
            border: 1px solid var(--border);
            background: var(--surface);
            padding: 10px 14px;
            border-radius: 10px;
            display: inline-flex; align-items: center; gap: 8px;
            font-size: .9rem;
            transition: background .15s, border-color .15s;
            white-space: nowrap;
        }
        .btn:hover { background: var(--primary-soft); border-color: var(--primary); }
        .btn.primary { background: var(--primary); border-color: var(--primary); color: var(--primary-text); }
        .btn.primary:hover { filter: brightness(1.08); }
        .btn .count {
            background: var(--primary); color: var(--primary-text);
            font-size: .72rem; padding: 0 7px; border-radius: 99px; font-weight: 600;
        }
        .btn svg { width: 16px; height: 16px; }

        /* 下拉多選 */
        .dd { position: relative; }
        .dd-panel {
            position: absolute; top: calc(100% + 8px); left: 0;
            z-index: 40;
            min-width: 230px; max-width: 320px;
            background: var(--surface);
            border: 1px solid var(--border);
            border-radius: 12px;
            box-shadow: 0 12px 40px rgba(15, 23, 42, .22);
            padding: 10px;
            display: none;
        }
        .dd.open .dd-panel { display: block; animation: pop .14s ease-out; }
        .dd.open > .btn { border-color: var(--primary); background: var(--primary-soft); }

        @keyframes pop { from { opacity: 0; transform: translateY(-4px); } to { opacity: 1; transform: none; } }

        .dd-search {
            width: 100%; margin-bottom: 8px; padding: 8px 10px;
            border-radius: 8px; border: 1px solid var(--border);
            background: var(--surface-2); font-size: .85rem;
        }
        .dd-list { max-height: 260px; overflow: auto; margin: 0 -4px; padding: 0 4px; }
        .dd-item {
            display: flex; align-items: center; gap: 9px;
            padding: 7px 8px; border-radius: 8px;
            font-size: .88rem; cursor: pointer; user-select: none;
        }
        .dd-item:hover { background: var(--row-hover); }
        .dd-item input { accent-color: var(--primary); width: 16px; height: 16px; margin: 0; }
        .dd-item .n { margin-left: auto; color: var(--text-3); font-size: .78rem; font-variant-numeric: tabular-nums; }
        .dd-foot { display: flex; justify-content: space-between; margin-top: 8px; padding-top: 8px; border-top: 1px solid var(--border); }
        .link-btn { background: none; border: 0; color: var(--primary); font-size: .82rem; padding: 4px 6px; border-radius: 6px; }
        .link-btn:hover { text-decoration: underline; }

        /* 價格區間 */
        .price-box {
            display: flex; align-items: center; gap: 14px; flex-wrap: wrap;
            margin-top: 14px; padding-top: 14px; border-top: 1px dashed var(--border);
        }
        .price-box .title { font-size: .85rem; color: var(--text-2); font-weight: 500; }
        .price-inputs { display: flex; align-items: center; gap: 8px; }
        .price-inputs input {
            width: 96px; padding: 8px 10px;
            border-radius: 8px; border: 1px solid var(--border);
            background: var(--surface-2); font-variant-numeric: tabular-nums;
        }
        .price-inputs input:focus { outline: none; border-color: var(--primary); }

        .range { position: relative; flex: 1 1 260px; height: 28px; min-width: 200px; }
        .range-track {
            position: absolute; left: 0; right: 0; top: 50%;
            height: 6px; transform: translateY(-50%);
            background: var(--border); border-radius: 99px;
        }
        .range-fill {
            position: absolute; top: 0; bottom: 0;
            background: var(--primary); border-radius: 99px;
        }
        .range input[type=range] {
            position: absolute; left: 0; top: 0;
            width: 100%; height: 28px; margin: 0;
            background: none; pointer-events: none;
            -webkit-appearance: none; appearance: none;
        }
        .range input[type=range]::-webkit-slider-thumb {
            -webkit-appearance: none; appearance: none;
            pointer-events: auto;
            width: 20px; height: 20px; border-radius: 50%;
            background: #fff; border: 3px solid var(--primary);
            box-shadow: 0 1px 4px rgba(0, 0, 0, .25); cursor: grab;
        }
        .range input[type=range]::-moz-range-thumb {
            pointer-events: auto;
            width: 14px; height: 14px; border-radius: 50%;
            background: #fff; border: 3px solid var(--primary);
            box-shadow: 0 1px 4px rgba(0, 0, 0, .25); cursor: grab;
        }
        .range input[type=range]::-webkit-slider-runnable-track { background: none; }
        .range input[type=range]::-moz-range-track { background: none; }

        /* 快速排序 */
        .quick { display: flex; gap: 6px; flex-wrap: wrap; align-items: center; margin-left: auto; }
        .quick .title { font-size: .85rem; color: var(--text-2); margin-right: 2px; }
        .pill {
            border: 1px solid var(--border); background: var(--surface-2);
            padding: 6px 12px; border-radius: 99px; font-size: .82rem;
            transition: all .15s;
        }
        .pill:hover { border-color: var(--primary); }
        .pill.active { background: var(--primary); border-color: var(--primary); color: var(--primary-text); }

        /* 已套用篩選 */
        .chips { display: flex; flex-wrap: wrap; gap: 8px; margin-top: 14px; }
        .chips:empty { display: none; }
        .chip {
            display: inline-flex; align-items: center; gap: 6px;
            padding: 4px 6px 4px 12px; border-radius: 99px;
            background: var(--primary-soft); color: var(--primary);
            font-size: .8rem; font-weight: 500;
        }
        .chip button {
            border: 0; background: transparent; color: inherit;
            width: 20px; height: 20px; border-radius: 50%; line-height: 1;
        }
        .chip button:hover { background: var(--primary); color: var(--primary-text); }

        /* ---------- Table ---------- */
        .table-card { overflow: hidden; }
        .table-wrap { overflow: auto; max-height: 72vh; }

        table { width: 100%; border-collapse: separate; border-spacing: 0; font-size: .92rem; }

        thead th {
            position: sticky; top: 0; z-index: 5;
            background: var(--surface-2);
            padding: 13px 14px;
            text-align: left;
            font-weight: 600; font-size: .8rem;
            color: var(--text-2);
            border-bottom: 1px solid var(--border);
            white-space: nowrap;
            user-select: none;
        }
        thead th.sortable { cursor: pointer; }
        thead th.sortable:hover { color: var(--primary); }
        thead th .arrow { display: inline-block; width: 14px; margin-left: 4px; opacity: .35; font-size: .7rem; }
        thead th.asc .arrow, thead th.desc .arrow { opacity: 1; color: var(--primary); }
        thead th.asc .arrow::before { content: "▲"; }
        thead th.desc .arrow::before { content: "▼"; }
        thead th:not(.asc):not(.desc) .arrow::before { content: "↕"; }
        thead th.asc, thead th.desc { color: var(--primary); }

        tbody td {
            padding: 12px 14px;
            border-bottom: 1px solid var(--border);
            vertical-align: middle;
            font-variant-numeric: tabular-nums;
        }
        tbody tr { transition: background .12s; }
        tbody tr:hover { background: var(--row-hover); }
        tbody tr:last-child td { border-bottom: 0; }

        .num { text-align: right; }
        thead th.num { text-align: right; }
        .idx { color: var(--text-3); width: 52px; }
        .na { color: var(--text-3); }

        /* 種類標籤：每個種類由 JS 指派不同色相 (--h) */
        .tag {
            display: inline-flex; align-items: center; gap: 6px;
            padding: 3px 10px; border-radius: 99px;
            background: hsl(var(--h, 220) 90% 94%);
            color: hsl(var(--h, 220) 65% 28%);
            border: 1px solid hsl(var(--h, 220) 70% 80%);
            font-size: .78rem; font-weight: 600; white-space: nowrap;
            cursor: pointer;
            transition: transform .12s, box-shadow .12s;
        }
        .tag::before {
            content: ""; width: 7px; height: 7px; border-radius: 50%;
            background: hsl(var(--h, 220) 70% 48%);
        }
        .tag:hover { transform: translateY(-1px); box-shadow: 0 2px 8px hsl(var(--h, 220) 70% 50% / .35); }
        [data-theme="dark"] .tag {
            background: hsl(var(--h, 220) 45% 20%);
            color: hsl(var(--h, 220) 85% 80%);
            border-color: hsl(var(--h, 220) 45% 32%);
        }
        .tdot { width: 10px; height: 10px; border-radius: 50%; flex-shrink: 0; background: hsl(var(--h, 220) 70% 52%); }

        /* 列左側色條，快速辨識種類 */
        tbody tr td:first-child { box-shadow: inset 4px 0 0 hsl(var(--h, 220) 70% 55%); }
        .brand { font-weight: 600; }

        .size-badge {
            display: inline-block; min-width: 56px; text-align: center;
            padding: 2px 8px; border-radius: 8px;
            background: var(--surface-2); border: 1px solid var(--border);
            font-weight: 600;
        }

        .model { display: inline-flex; align-items: center; gap: 6px; font-family: ui-monospace, SFMono-Regular, Menlo, Consolas, monospace; font-size: .85rem; }
        .model button, .model a {
            border: 0; background: transparent; padding: 3px; border-radius: 6px;
            color: var(--text-3); display: inline-grid; place-items: center; opacity: 0;
            transition: opacity .15s, color .15s;
        }
        tr:hover .model button, tr:hover .model a, .model button:focus-visible, .model a:focus-visible { opacity: 1; }
        .model button:hover, .model a:hover { color: var(--primary); background: var(--primary-soft); }
        .model svg { width: 15px; height: 15px; }

        .price { font-weight: 700; font-size: 1rem; }
        .price::before { content: "$"; font-weight: 500; color: var(--text-3); margin-right: 1px; }

        .cp { min-width: 150px; }
        .cp-top { display: flex; align-items: center; justify-content: flex-end; gap: 8px; font-weight: 600; }
        .cp-bar { height: 5px; border-radius: 99px; background: var(--border); margin-top: 6px; overflow: hidden; }
        .cp-bar i { display: block; height: 100%; border-radius: 99px; background: linear-gradient(90deg, var(--good), #22d3ee); }
        .rank {
            font-size: .7rem; font-weight: 700; padding: 1px 8px; border-radius: 99px;
            background: var(--warn-soft); color: var(--warn);
        }
        tr.is-top .cp-top .v { color: var(--good); }

        .empty {
            display: none; padding: 60px 20px; text-align: center; color: var(--text-2);
        }
        .empty.show { display: block; }
        .empty .big { font-size: 2.4rem; margin-bottom: 6px; }

        /* 每 TB 價分級顏色 */
        .cp-low .v { color: var(--good); }
        .cp-mid .v { color: var(--warn); }
        .cp-high .v { color: var(--danger); }
        .cp-mid .cp-bar i { background: linear-gradient(90deg, var(--warn), #fbbf24); }
        .cp-high .cp-bar i { background: linear-gradient(90deg, var(--danger), #fb923c); }
        .legend { display: inline-flex; align-items: center; gap: 6px; font-size: .78rem; }
        .lg { width: 9px; height: 9px; border-radius: 50%; display: inline-block; }
        .lg-low { background: var(--good); }
        .lg-mid { background: var(--warn); }
        .lg-high { background: var(--danger); }

        /* 收藏 */
        th.fav, td.fav { width: 36px; padding-left: 4px; padding-right: 0; text-align: center; }
        .star {
            border: 0; background: none; font-size: 1.2rem; line-height: 1;
            color: var(--text-3); padding: 2px 4px; border-radius: 6px;
            transition: transform .12s, color .12s;
        }
        .star:hover { transform: scale(1.2); color: #f59e0b; }
        .star[aria-pressed="true"] { color: #f59e0b; }
        tr.is-fav { background: color-mix(in srgb, #f59e0b 7%, transparent); }

        .hero-actions { display: flex; gap: 10px; }

        /* 緊湊列高 */
        body.compact tbody td { padding: 6px 12px; font-size: .86rem; }
        body.compact .cp-bar { display: none; }
        body.compact .size-badge { padding: 0 8px; }

        /* ---------- Pagination ---------- */
        .pager {
            display: flex; align-items: center; justify-content: space-between;
            flex-wrap: wrap; gap: 12px;
            padding: 12px 16px; border-top: 1px solid var(--border);
            background: var(--surface-2); font-size: .85rem; color: var(--text-2);
        }
        .pager-left { display: flex; align-items: center; gap: 10px; flex-wrap: wrap; }
        .pager select {
            padding: 6px 10px; border-radius: 8px;
            border: 1px solid var(--border); background: var(--surface);
        }
        .pages { display: flex; gap: 4px; flex-wrap: wrap; }
        .pages button {
            min-width: 34px; height: 34px; padding: 0 8px;
            border-radius: 8px; border: 1px solid var(--border);
            background: var(--surface);
        }
        .pages button:hover:not(:disabled) { border-color: var(--primary); color: var(--primary); }
        .pages button.cur { background: var(--primary); border-color: var(--primary); color: var(--primary-text); }
        .pages button:disabled { opacity: .4; cursor: not-allowed; }

        footer { margin-top: 22px; text-align: center; color: var(--text-3); font-size: .8rem; }

        /* ---------- Floating ---------- */
        .to-top {
            position: fixed; right: 20px; bottom: 20px;
            width: 46px; height: 46px; border-radius: 50%;
            border: 0; background: var(--primary); color: var(--primary-text);
            box-shadow: 0 8px 24px rgba(79, 70, 229, .4);
            display: grid; place-items: center;
            opacity: 0; pointer-events: none; transform: translateY(10px);
            transition: all .2s; z-index: 50;
        }
        .to-top.show { opacity: 1; pointer-events: auto; transform: none; }
        .to-top svg { width: 20px; height: 20px; }

        .toast {
            position: fixed; left: 50%; bottom: 28px;
            transform: translate(-50%, 20px);
            background: var(--text); color: var(--bg);
            padding: 10px 18px; border-radius: 99px; font-size: .88rem;
            opacity: 0; pointer-events: none; transition: all .22s; z-index: 60;
        }
        .toast.show { opacity: 1; transform: translate(-50%, 0); }

        /* ---------- RWD ---------- */
        @media (max-width: 900px) {
            .quick { margin-left: 0; width: 100%; }
        }

        @media (max-width: 820px) {
            .container { padding: 16px 12px 80px; }
            .table-wrap { max-height: none; overflow: visible; }
            table, tbody { display: block; }
            thead { display: none; }

            tbody tr {
                display: grid;
                grid-template-columns: 1fr 1fr;
                gap: 2px 14px;
                padding: 14px 16px;
                margin: 12px;
                border: 1px solid var(--border);
                border-radius: 12px;
                background: var(--surface);
            }
            tbody tr:hover { background: var(--surface); }
            tbody tr { position: relative; border-left: 4px solid hsl(var(--h, 220) 70% 55%); }
            tbody tr td:first-child { box-shadow: none; }
            tbody td.fav { position: absolute; top: 8px; right: 10px; padding: 0; display: block; width: auto; }
            tbody td.fav::before { display: none; }

            tbody td {
                display: flex; align-items: center; justify-content: space-between;
                gap: 10px; border: 0; padding: 6px 0; text-align: right;
                font-size: .88rem;
            }
            tbody td::before {
                content: attr(data-label);
                color: var(--text-3); font-size: .76rem; font-weight: 500; flex-shrink: 0;
            }
            tbody td.idx { display: none; }
            tbody td.c-brand, tbody td.c-model, tbody td.c-series, tbody td.cp, tbody td.c-price { grid-column: 1 / -1; }
            tbody td.c-price { border-top: 1px dashed var(--border); margin-top: 6px; padding-top: 10px; }
            tbody td.cp { display: block; min-width: 0; }
            tbody td.cp::before { display: block; text-align: left; margin-bottom: 2px; }
            .cp-top { justify-content: space-between; }
            .model button, .model a { opacity: 1; }

            .dd-panel { position: fixed; left: 12px; right: 12px; top: auto; bottom: 12px; max-width: none; border-radius: 16px; }
            .dd-list { max-height: 40vh; }
            .pager { justify-content: center; }
        }

        @media (max-width: 480px) {
            .stat .value { font-size: 1.3rem; }
            .price-inputs input { width: 82px; }
        }

        @media (prefers-reduced-motion: reduce) {
            * { animation: none !important; transition: none !important; scroll-behavior: auto !important; }
        }

        @media print {
            .toolbar, .pager, .to-top, .icon-btn, .toast { display: none !important; }
            .table-wrap { max-height: none; overflow: visible; }
            body { background: #fff; color: #000; }
        }
    </style>
</head>
<body>
{% macro show(x) %}{% if x is none %}<span class="na">—</span>{% else %}{{ x|e }}{% endif %}{% endmacro %}
{% macro raw(x) %}{% if x is none %}{% else %}{{ x|e }}{% endif %}{% endmacro %}

<div class="container">

    <!-- ===== 標題 ===== -->
    <header class="hero">
        <div>
            <h1>
                <span class="logo" aria-hidden="true">
                    <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><ellipse cx="12" cy="6" rx="8" ry="3"/><path d="M4 6v6c0 1.66 3.58 3 8 3s8-1.34 8-3V6"/><path d="M4 12v6c0 1.66 3.58 3 8 3s8-1.34 8-3v-6"/></svg>
                </span>
                傳統內接硬碟 HDD 比價表
            </h1>
            <div class="meta">
                <span><i class="dot"></i>資料來自原價屋</span>
                <span>更新時間：{{ update_time }}</span>
            </div>
        </div>
        <div class="hero-actions">
        <button class="icon-btn" id="densityBtn" type="button" title="切換緊湊／舒適列高" aria-label="切換緊湊／舒適列高">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><path d="M4 6h16M4 10h16M4 14h16M4 18h16"/></svg>
        </button>
        <button class="icon-btn" id="themeBtn" type="button" title="切換深色／淺色模式" aria-label="切換深色／淺色模式">
            <svg class="icon-moon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M21 12.8A9 9 0 1 1 11.2 3a7 7 0 0 0 9.8 9.8z"/></svg>
            <svg class="icon-sun" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="4"/><path d="M12 2v2M12 20v2M4.9 4.9l1.4 1.4M17.7 17.7l1.4 1.4M2 12h2M20 12h2M4.9 19.1l1.4-1.4M17.7 6.3l1.4-1.4"/></svg>
        </button>
        </div>
    </header>

    <!-- ===== 統計卡片 ===== -->
    <section class="stats" aria-label="統計摘要">
        <div class="stat">
            <div class="label">符合條件</div>
            <div class="value"><span id="statCount">0</span><small>/ <span id="statTotal">0</span> 筆</small></div>
            <div class="hint">依目前篩選結果計算</div>
        </div>
        <div class="stat">
            <div class="label">最低價格</div>
            <div class="value">$<span id="statMinPrice">-</span></div>
            <div class="hint" id="statMinPriceHint">&nbsp;</div>
        </div>
        <div class="stat accent">
            <div class="label">最划算（每 TB 最低）</div>
            <div class="value">$<span id="statBestCp">-</span><small>/TB</small></div>
            <div class="hint" id="statBestCpHint">&nbsp;</div>
        </div>
        <div class="stat">
            <div class="label">平均每 TB 價</div>
            <div class="value">$<span id="statAvgCp">-</span><small>/TB</small></div>
            <div class="hint">供評估行情參考</div>
        </div>
    </section>

    <!-- ===== 工具列 ===== -->
    <section class="card toolbar" aria-label="篩選工具">
        <div class="toolbar-row">
            <label class="search">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><circle cx="11" cy="11" r="7"/><path d="m20 20-3.5-3.5"/></svg>
                <input id="q" type="search" placeholder="搜尋品牌、型號、系列…（例如：WD 藍標、ST4000）" autocomplete="off" aria-label="搜尋">
                <kbd>/</kbd>
            </label>
            <div id="filterBar" class="toolbar-row" style="gap:10px"></div>
            <button class="btn" id="resetBtn" type="button">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M3 12a9 9 0 1 0 3-6.7L3 8"/><path d="M3 3v5h5"/></svg>
                清除篩選
            </button>
            <button class="btn" id="favBtn" type="button" aria-pressed="false">★ 只看收藏 <span class="count">0</span></button>
            <button class="btn" id="csvBtn" type="button" title="匯出目前篩選結果">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M12 3v12"/><path d="m7 10 5 5 5-5"/><path d="M5 21h14"/></svg>
                匯出 CSV
            </button>
            <!-- <button class="btn" id="shareBtn" type="button" title="複製含目前篩選條件的連結">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M10 13a5 5 0 0 0 7.5.5l3-3a5 5 0 0 0-7-7l-1.7 1.7"/><path d="M14 11a5 5 0 0 0-7.5-.5l-3 3a5 5 0 0 0 7 7l1.7-1.7"/></svg>
                分享連結
            </button> --!>
        </div>

        <div class="price-box">
            <span class="title">價格區間</span>
            <div class="price-inputs">
                <input id="priceMin" type="number" inputmode="numeric" min="0" aria-label="最低價格">
                <span>～</span>
                <input id="priceMax" type="number" inputmode="numeric" min="0" aria-label="最高價格">
            </div>
            <div class="range">
                <div class="range-track"><div class="range-fill" id="rangeFill"></div></div>
                <input id="rangeMin" type="range" min="0" max="20000" step="100" value="0" aria-label="最低價格滑桿">
                <input id="rangeMax" type="range" min="0" max="20000" step="100" value="20000" aria-label="最高價格滑桿">
            </div>
            <div class="quick" role="group" aria-label="快速排序">
                <span class="title">快速排序</span>
                <button type="button" class="pill" data-quick="cp:asc">每 T 最便宜</button>
                <button type="button" class="pill" data-quick="price:asc">價格低→高</button>
                <button type="button" class="pill" data-quick="size:desc">容量大→小</button>
                <button type="button" class="pill" data-quick="">預設順序</button>
            </div>
        </div>

        <div class="chips" id="chips" aria-live="polite"></div>
    </section>

    <!-- ===== 表格 ===== -->
    <section class="card table-card">
        <div class="table-wrap">
            <table id="hddTable">
                <thead>
                <tr>
                    <th class="idx">#</th>
                    <th class="fav" aria-label="收藏"></th>
                    <th class="sortable" data-sort="type" data-kind="text">種類<span class="arrow"></span></th>
                    <th class="sortable" data-sort="brand" data-kind="text">品牌<span class="arrow"></span></th>
                    <th class="sortable num" data-sort="size" data-kind="num">容量 (TB)<span class="arrow"></span></th>
                    <th class="sortable" data-sort="series" data-kind="text">系列<span class="arrow"></span></th>
                    <th class="sortable num" data-sort="cache" data-kind="num">快取 (MB)<span class="arrow"></span></th>
                    <th class="sortable" data-sort="model" data-kind="text">型號<span class="arrow"></span></th>
                    <th class="sortable num" data-sort="rpm" data-kind="num">轉速 RPM<span class="arrow"></span></th>
                    <th class="sortable num" data-sort="warranty" data-kind="num">保固 (年)<span class="arrow"></span></th>
                    <th class="sortable num" data-sort="price" data-kind="num">價格<span class="arrow"></span></th>
                    <th class="sortable num" data-sort="cp" data-kind="num">每 TB 價<span class="arrow"></span></th>
                </tr>
                </thead>
                <tbody id="hddBody">
                {% for item in items %}
                    <tr data-type="{{ raw(item.subtitle) }}"
                        data-brand="{{ raw(item.brand) }}"
                        data-size="{{ raw(item.size) }}"
                        data-series="{{ raw(item.series) }}"
                        data-cache="{{ raw(item.memory) }}"
                        data-model="{{ raw(item.model) }}"
                        data-rpm="{{ raw(item.rpm) }}"
                        data-warranty="{{ raw(item.warranty) }}"
                        data-price="{{ raw(item.price) }}"
                        data-cp="{{ item.cp_value|int if item.cp_value is not none else '' }}">
                        <td class="idx" data-label="#">{{ loop.index }}</td>
                        <td class="fav" data-label=""><button type="button" class="star" aria-pressed="false" aria-label="加入收藏">☆</button></td>
                        <td class="c-type" data-label="種類">{% if item.subtitle is none %}<span class="na">—</span>{% else %}<span class="tag">{{ item.subtitle|e }}</span>{% endif %}</td>
                        <td class="c-brand brand" data-label="品牌">{{ show(item.brand) }}</td>
                        <td class="num c-size" data-label="容量">{% if item.size is none %}<span class="na">—</span>{% else %}<span class="size-badge">{{ item.size }} TB</span>{% endif %}</td>
                        <td class="c-series" data-label="系列">{{ show(item.series) }}</td>
                        <td class="num c-cache" data-label="快取">{{ show(item.memory) }}</td>
                        <td class="c-model" data-label="型號">{% if item.model is none %}<span class="na">—</span>{% else %}<span class="model"><span>{{ item.model|e }}</span><button type="button" class="copy" data-copy="{{ item.model|e }}" title="複製型號" aria-label="複製型號"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="9" y="9" width="12" height="12" rx="2"/><path d="M5 15V5a2 2 0 0 1 2-2h10"/></svg></button><a href="https://www.google.com/search?q={{ (item.brand ~ ' ' ~ item.model)|urlencode }}" target="_blank" rel="noopener noreferrer" title="Google 搜尋此型號" aria-label="Google 搜尋此型號"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M14 3h7v7"/><path d="M10 14 21 3"/><path d="M21 14v5a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h5"/></svg></a></span>{% endif %}</td>
                        <td class="num c-rpm" data-label="轉速">{{ show(item.rpm) }}</td>
                        <td class="num c-warranty" data-label="保固">{{ show(item.warranty) }}</td>
                        <td class="num c-price" data-label="價格">{% if item.price is none %}<span class="na">—</span>{% else %}<span class="price">{{ item.price }}</span>{% endif %}</td>
                        <td class="num cp" data-label="每 TB 價">{% if item.cp_value is none %}<span class="na">—</span>{% else %}<div class="cp-top"><span class="rank" hidden></span><span class="v">${{ item.cp_value|int }}</span></div><div class="cp-bar"><i></i></div>{% endif %}</td>
                    </tr>
                {% endfor %}
                </tbody>
            </table>
            <div class="empty" id="empty">
                <div class="big">🔍</div>
                <div><strong>找不到符合條件的硬碟</strong></div>
                <div>試著放寬價格區間，或清除部分篩選條件。</div>
                <p><button type="button" class="btn primary" id="emptyReset">清除所有篩選</button></p>
            </div>
        </div>

        <div class="pager">
            <div class="pager-left">
                <span id="pagerInfo">-</span>
                <span class="legend" title="依每 TB 價三等分"><i class="lg lg-low"></i>便宜<i class="lg lg-mid"></i>中等<i class="lg lg-high"></i>偏貴</span>
                <label>每頁
                    <select id="pageSize" aria-label="每頁筆數">
                        <option value="25">25</option>
                        <option value="50" selected>50</option>
                        <option value="100">100</option>
                        <option value="0">全部</option>
                    </select>
                    筆
                </label>
            </div>
            <div class="pages" id="pages"></div>
        </div>
    </section>

    <footer>價格以原價屋網站公告為準，實際售價與庫存請以店家為準。</footer>
</div>

<button class="to-top" id="toTop" type="button" aria-label="回到頂端">
    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round"><path d="m6 15 6-6 6 6"/></svg>
</button>
<div class="toast" id="toast" role="status"></div>

<script>
(function () {
    'use strict';

    var $ = function (s, r) { return (r || document).querySelector(s); };
    var $$ = function (s, r) { return Array.prototype.slice.call((r || document).querySelectorAll(s)); };

    /* ---------- 讀取資料 ---------- */
    function toNum(v) {
        if (v === '' || v == null) return null;
        var n = Number(v);
        return isNaN(n) ? null : n;
    }

    var tbody = $('#hddBody');
    var data = $$('tr', tbody).map(function (tr) {
        var d = tr.dataset;
        return {
            el: tr,
            type: d.type, brand: d.brand, series: d.series, model: d.model,
            cache: d.cache, warranty: d.warranty, rpmS: d.rpm, sizeS: d.size,
            size: toNum(d.size), rpm: toNum(d.rpm), price: toNum(d.price), cp: toNum(d.cp),
            cacheN: toNum(d.cache), warrantyN: toNum(d.warranty),
            text: tr.textContent.toLowerCase().replace(/\s+/g, ' ')
        };
    });

    /* 排序用的數值欄位對照 */
    var NUM_MAP = { size: 'size', rpm: 'rpm', price: 'price', cp: 'cp', cache: 'cacheN', warranty: 'warrantyN' };

    /* ---------- 種類配色：每個種類一個色相 ---------- */
    var HUES = [215, 152, 28, 335, 268, 188, 95, 8, 48, 300, 128, 245];
    var typeHue = {}, typeCount = 0;
    var rowOf = new Map();
    data.forEach(function (r) {
        rowOf.set(r.el, r);
        if (r.type && typeHue[r.type] === undefined) {
            typeHue[r.type] = typeCount < HUES.length ? HUES[typeCount] : Math.round((typeCount * 137.508) % 360);
            typeCount++;
        }
        r.el.style.setProperty('--h', r.type ? typeHue[r.type] : 220);
        var tag = $('.tag', r.el);
        if (tag) { tag.title = '點擊只看「' + r.type + '」'; tag.tabIndex = 0; tag.setAttribute('role', 'button'); }
    });

    /* ---------- 收藏 (localStorage) ---------- */
    var favs = new Set();
    try { favs = new Set(JSON.parse(localStorage.getItem('hdd-favs') || '[]')); } catch (e) {}
    function saveFavs() { try { localStorage.setItem('hdd-favs', JSON.stringify(Array.from(favs))); } catch (e) {} }
    data.forEach(function (r) {
        r.key = [r.type, r.brand, r.sizeS, r.series, r.model, r.cache, r.rpmS, r.warranty].join('|');
    });
    function paintStar(r) {
        var on = favs.has(r.key), b = $('.star', r.el);
        if (!b) return;
        b.textContent = on ? '★' : '☆';
        b.setAttribute('aria-pressed', on ? 'true' : 'false');
        b.setAttribute('aria-label', on ? '取消收藏' : '加入收藏');
        r.el.classList.toggle('is-fav', on);
    }
    function toggleFav(tr) {
        var r = rowOf.get(tr);
        if (!r) return;
        if (favs.has(r.key)) favs.delete(r.key); else favs.add(r.key);
        saveFavs(); paintStar(r);
        if (state.favOnly) update(); else renderFavBtn();
    }

    /* ---------- 全域 CP 排名 / 長條 ---------- */
    var cps = data.filter(function (r) { return r.cp != null; }).map(function (r) { return r.cp; });
    var bestCp = cps.length ? Math.min.apply(null, cps) : 0;
    data.slice().filter(function (r) { return r.cp != null; })
        .sort(function (a, b) { return a.cp - b.cp; })
        .slice(0, 3)
        .forEach(function (r, i) {
            r.el.classList.add('is-top');
            var badge = $('.rank', r.el);
            if (badge) { badge.hidden = false; badge.textContent = '🏆 TOP ' + (i + 1); }
        });
    var sortedCps = cps.slice().sort(function (a, b) { return a - b; });
    var tier1 = sortedCps[Math.floor(sortedCps.length / 3)];
    var tier2 = sortedCps[Math.floor(sortedCps.length * 2 / 3)];
    data.forEach(function (r) {
        var bar = $('.cp-bar i', r.el);
        if (bar && r.cp) bar.style.width = Math.max(6, Math.round(bestCp / r.cp * 100)) + '%';
        var td = $('td.cp', r.el);
        if (td && r.cp != null) {
            var tier = r.cp < tier1 ? 'low' : (r.cp < tier2 ? 'mid' : 'high');
            td.classList.add('cp-' + tier);
            td.title = '每 TB 價：' + (tier === 'low' ? '便宜' : tier === 'mid' ? '中等' : '偏貴');
        }
    });

    /* ---------- 狀態 ---------- */
    var FILTERS = [
        { key: 'type', label: '種類' },
        { key: 'brand', label: '品牌' },
        { key: 'sizeS', label: '容量', fmt: function (v) { return v + ' TB'; }, numeric: true },
        { key: 'series', label: '系列' },
        { key: 'cache', label: '快取', fmt: function (v) { return v + ' MB'; }, numeric: true },
        { key: 'rpmS', label: '轉速', fmt: function (v) { return v + ' RPM'; }, numeric: true },
        { key: 'warranty', label: '保固', fmt: function (v) { return v + ' 年'; }, numeric: true }
    ];

    var state = {
        q: '',
        selected: {},
        priceMin: 0, priceMax: 0,
        sortKey: '', sortDir: 'asc', sortKind: 'num',
        favOnly: false,
        page: 1, pageSize: 50
    };
    FILTERS.forEach(function (f) { state.selected[f.key] = new Set(); });

    var prices = data.map(function (r) { return r.price; }).filter(function (v) { return v != null; });
    var PRICE_CEIL = Math.max(1000, Math.ceil((prices.length ? Math.max.apply(null, prices) : 1000) / 500) * 500);
    state.priceMax = PRICE_CEIL;

    /* ---------- 篩選下拉 ---------- */
    var filterBar = $('#filterBar');
    var ddRefs = {};

    function buildFilter(f) {
        var counts = {};
        data.forEach(function (r) {
            var v = r[f.key] || '';
            counts[v] = (counts[v] || 0) + 1;
        });
        var values = Object.keys(counts).filter(function (v) { return v !== ''; });
        if (f.numeric) values.sort(function (a, b) { return Number(a) - Number(b); });
        else values.sort(function (a, b) { return a.localeCompare(b, 'zh-Hant'); });
        if (values.length <= 1) return;   // 只有一種值就不需要篩選

        var wrap = document.createElement('div');
        wrap.className = 'dd';
        var btn = document.createElement('button');
        btn.type = 'button';
        btn.className = 'btn';
        btn.setAttribute('aria-haspopup', 'listbox');
        btn.innerHTML = '<span>' + f.label + '</span><span class="count" hidden>0</span>' +
            '<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="m6 9 6 6 6-6"/></svg>';

        var panel = document.createElement('div');
        panel.className = 'dd-panel';

        var search = null;
        if (values.length > 8) {
            search = document.createElement('input');
            search.className = 'dd-search';
            search.placeholder = '搜尋' + f.label + '…';
            panel.appendChild(search);
        }

        var list = document.createElement('div');
        list.className = 'dd-list';
        values.forEach(function (v) {
            var label = document.createElement('label');
            label.className = 'dd-item';
            label.dataset.v = (f.fmt ? f.fmt(v) : v).toLowerCase();
            var cb = document.createElement('input');
            cb.type = 'checkbox';
            cb.value = v;
            cb.addEventListener('change', function () {
                if (cb.checked) state.selected[f.key].add(v); else state.selected[f.key].delete(v);
                state.page = 1;
                update();
            });
            var span = document.createElement('span');
            span.textContent = f.fmt ? f.fmt(v) : v;
            var n = document.createElement('span');
            n.className = 'n';
            n.textContent = counts[v];
            label.appendChild(cb);
            if (f.key === 'type') {
                var dot = document.createElement('i');
                dot.className = 'tdot';
                dot.style.setProperty('--h', typeHue[v]);
                label.appendChild(dot);
            }
            label.appendChild(span); label.appendChild(n);
            list.appendChild(label);
        });
        panel.appendChild(list);

        var foot = document.createElement('div');
        foot.className = 'dd-foot';
        var clear = document.createElement('button');
        clear.type = 'button'; clear.className = 'link-btn'; clear.textContent = '清除此項';
        clear.addEventListener('click', function () {
            state.selected[f.key].clear(); state.page = 1; update();
        });
        var done = document.createElement('button');
        done.type = 'button'; done.className = 'link-btn'; done.textContent = '完成';
        done.addEventListener('click', function () { wrap.classList.remove('open'); });
        foot.appendChild(clear); foot.appendChild(done);
        panel.appendChild(foot);

        if (search) {
            search.addEventListener('input', function () {
                var kw = search.value.trim().toLowerCase();
                $$('.dd-item', list).forEach(function (it) {
                    it.style.display = it.dataset.v.indexOf(kw) === -1 ? 'none' : '';
                });
            });
        }

        btn.addEventListener('click', function (e) {
            e.stopPropagation();
            var willOpen = !wrap.classList.contains('open');
            closeAllDd();
            if (willOpen) wrap.classList.add('open');
        });
        panel.addEventListener('click', function (e) { e.stopPropagation(); });

        wrap.appendChild(btn); wrap.appendChild(panel);
        filterBar.appendChild(wrap);
        ddRefs[f.key] = { list: list, badge: $('.count', btn) };
    }

    function closeAllDd() { $$('.dd.open').forEach(function (d) { d.classList.remove('open'); }); }
    document.addEventListener('click', closeAllDd);
    document.addEventListener('keydown', function (e) { if (e.key === 'Escape') closeAllDd(); });

    FILTERS.forEach(buildFilter);

    /* ---------- 價格區間 ---------- */
    var rangeMin = $('#rangeMin'), rangeMax = $('#rangeMax');
    var priceMin = $('#priceMin'), priceMax = $('#priceMax');
    var rangeFill = $('#rangeFill');
    [rangeMin, rangeMax].forEach(function (r) { r.max = PRICE_CEIL; });
    priceMin.max = priceMax.max = PRICE_CEIL;

    function syncPriceUI() {
        rangeMin.value = state.priceMin;
        rangeMax.value = state.priceMax;
        priceMin.value = state.priceMin;
        priceMax.value = state.priceMax;
        rangeFill.style.left = (state.priceMin / PRICE_CEIL * 100) + '%';
        rangeFill.style.right = (100 - state.priceMax / PRICE_CEIL * 100) + '%';
    }

    function setPrice(min, max, from) {
        min = Math.max(0, Math.min(min, PRICE_CEIL));
        max = Math.max(0, Math.min(max, PRICE_CEIL));
        if (min > max) { if (from === 'min') min = max; else max = min; }
        state.priceMin = min; state.priceMax = max; state.page = 1;
        update();
    }

    rangeMin.addEventListener('input', function () { setPrice(+rangeMin.value, state.priceMax, 'min'); });
    rangeMax.addEventListener('input', function () { setPrice(state.priceMin, +rangeMax.value, 'max'); });
    priceMin.addEventListener('change', function () { setPrice(+priceMin.value || 0, state.priceMax, 'min'); });
    priceMax.addEventListener('change', function () { setPrice(state.priceMin, priceMax.value === '' ? PRICE_CEIL : +priceMax.value, 'max'); });

    /* ---------- 搜尋 ---------- */
    var qInput = $('#q');
    var qTimer;
    qInput.addEventListener('input', function () {
        clearTimeout(qTimer);
        qTimer = setTimeout(function () {
            state.q = qInput.value.trim().toLowerCase();
            state.page = 1;
            update();
        }, 120);
    });
    document.addEventListener('keydown', function (e) {
        var tag = (document.activeElement && document.activeElement.tagName) || '';
        if (e.key === '/' && tag !== 'INPUT' && tag !== 'SELECT' && tag !== 'TEXTAREA') {
            e.preventDefault();
            qInput.focus();
        }
    });

    /* ---------- 排序 ---------- */
    $$('thead th.sortable').forEach(function (th) {
        th.tabIndex = 0;
        function go() {
            var key = th.dataset.sort, kind = th.dataset.kind;
            if (state.sortKey === key) {
                if (state.sortDir === 'asc') state.sortDir = 'desc';
                else { state.sortKey = ''; state.sortDir = 'asc'; }
            } else {
                state.sortKey = key; state.sortKind = kind;
                state.sortDir = (kind === 'num' && (key === 'size' || key === 'rpm' || key === 'cache')) ? 'desc' : 'asc';
            }
            state.page = 1;
            update();
        }
        th.addEventListener('click', go);
        th.addEventListener('keydown', function (e) { if (e.key === 'Enter' || e.key === ' ') { e.preventDefault(); go(); } });
    });

    $$('[data-quick]').forEach(function (b) {
        b.addEventListener('click', function () {
            var v = b.dataset.quick;
            if (!v) { state.sortKey = ''; state.sortDir = 'asc'; }
            else {
                var p = v.split(':');
                state.sortKey = p[0]; state.sortDir = p[1]; state.sortKind = 'num';
            }
            state.page = 1;
            update();
        });
    });

    function compare(a, b) {
        var key = state.sortKey, dir = state.sortDir === 'asc' ? 1 : -1;
        var va, vb;
        if (state.sortKind === 'num') { va = a[NUM_MAP[key]]; vb = b[NUM_MAP[key]]; }
        else { va = a[key] || ''; vb = b[key] || ''; }
        var an = (va === null || va === ''), bn = (vb === null || vb === '');
        if (an && bn) return 0;
        if (an) return 1;           // 空值永遠排最後
        if (bn) return -1;
        if (state.sortKind === 'num') return (va - vb) * dir;
        return va.localeCompare(vb, 'zh-Hant') * dir;
    }

    /* ---------- 清除 ---------- */
    function resetAll() {
        state.q = ''; qInput.value = '';
        FILTERS.forEach(function (f) { state.selected[f.key].clear(); });
        state.priceMin = 0; state.priceMax = PRICE_CEIL;
        state.sortKey = ''; state.sortDir = 'asc';
        state.favOnly = false;
        state.page = 1;
        update();
    }
    $('#resetBtn').addEventListener('click', resetAll);
    $('#emptyReset').addEventListener('click', resetAll);

    /* ---------- 主更新流程 ---------- */
    var filtered = [];

    function matches(r) {
        if (state.favOnly && !favs.has(r.key)) return false;
        if (state.q) {
            var words = state.q.split(/\s+/);
            for (var i = 0; i < words.length; i++) if (r.text.indexOf(words[i]) === -1) return false;
        }
        for (var k = 0; k < FILTERS.length; k++) {
            var f = FILTERS[k], sel = state.selected[f.key];
            if (sel.size && !sel.has(r[f.key] || '')) return false;
        }
        if (r.price != null) {
            if (r.price < state.priceMin || r.price > state.priceMax) return false;
        } else if (state.priceMin > 0 || state.priceMax < PRICE_CEIL) return false;
        return true;
    }

    function fmtMoney(n) { return n.toLocaleString('en-US'); }

    function describe(r) {
        var parts = [r.brand, r.size != null ? r.size + 'TB' : '', r.series || r.model || ''];
        return parts.filter(Boolean).join(' ');
    }

    function update() {
        filtered = data.filter(matches);
        if (state.sortKey) filtered.sort(compare);
        else filtered.sort(function (a, b) { return data.indexOf(a) - data.indexOf(b); });

        // 分頁
        var total = filtered.length;
        var size = state.pageSize || total || 1;
        var pageCount = Math.max(1, Math.ceil(total / size));
        if (state.page > pageCount) state.page = pageCount;
        var start = (state.page - 1) * size;
        var pageRows = filtered.slice(start, start + size);

        var frag = document.createDocumentFragment();
        pageRows.forEach(function (r, i) {
            $('.idx', r.el).textContent = start + i + 1;
            frag.appendChild(r.el);
        });
        tbody.replaceChildren(frag);
        $('#empty').classList.toggle('show', total === 0);

        renderHeader();
        renderStats();
        renderChips();
        renderDd();
        renderFavBtn();
        writeHash();
        renderPager(total, pageCount, start, pageRows.length);
        syncPriceUI();
    }

    function renderHeader() {
        $$('thead th.sortable').forEach(function (th) {
            th.classList.remove('asc', 'desc');
            if (th.dataset.sort === state.sortKey) th.classList.add(state.sortDir);
            th.setAttribute('aria-sort', th.dataset.sort === state.sortKey ? (state.sortDir === 'asc' ? 'ascending' : 'descending') : 'none');
        });
        $$('[data-quick]').forEach(function (b) {
            var cur = state.sortKey ? state.sortKey + ':' + state.sortDir : '';
            b.classList.toggle('active', b.dataset.quick === cur);
        });
    }

    function renderStats() {
        $('#statCount').textContent = fmtMoney(filtered.length);
        $('#statTotal').textContent = fmtMoney(data.length);

        var withPrice = filtered.filter(function (r) { return r.price != null; });
        var withCp = filtered.filter(function (r) { return r.cp != null; });

        if (withPrice.length) {
            var minP = withPrice.reduce(function (a, b) { return a.price <= b.price ? a : b; });
            $('#statMinPrice').textContent = fmtMoney(minP.price);
            $('#statMinPriceHint').textContent = describe(minP);
        } else { $('#statMinPrice').textContent = '-'; $('#statMinPriceHint').innerHTML = '&nbsp;'; }

        if (withCp.length) {
            var best = withCp.reduce(function (a, b) { return a.cp <= b.cp ? a : b; });
            var avg = Math.round(withCp.reduce(function (s, r) { return s + r.cp; }, 0) / withCp.length);
            $('#statBestCp').textContent = fmtMoney(best.cp);
            $('#statBestCpHint').textContent = describe(best) + '・$' + fmtMoney(best.price);
            $('#statAvgCp').textContent = fmtMoney(avg);
        } else {
            $('#statBestCp').textContent = '-'; $('#statBestCpHint').innerHTML = '&nbsp;'; $('#statAvgCp').textContent = '-';
        }
    }

    function renderDd() {
        FILTERS.forEach(function (f) {
            var ref = ddRefs[f.key];
            if (!ref) return;
            var sel = state.selected[f.key];
            ref.badge.hidden = sel.size === 0;
            ref.badge.textContent = sel.size;
            $$('input', ref.list).forEach(function (cb) { cb.checked = sel.has(cb.value); });
        });
    }

    function renderChips() {
        var box = $('#chips');
        box.innerHTML = '';
        function add(text, onRemove) {
            var c = document.createElement('span');
            c.className = 'chip';
            c.appendChild(document.createTextNode(text));
            var x = document.createElement('button');
            x.type = 'button'; x.setAttribute('aria-label', '移除 ' + text); x.textContent = '×';
            x.addEventListener('click', function () { onRemove(); state.page = 1; update(); });
            c.appendChild(x);
            box.appendChild(c);
        }
        if (state.q) add('搜尋：' + state.q, function () { state.q = ''; qInput.value = ''; });
        if (state.favOnly) add('★ 只看收藏', function () { state.favOnly = false; });
        FILTERS.forEach(function (f) {
            state.selected[f.key].forEach(function (v) {
                add(f.label + '：' + (f.fmt ? f.fmt(v) : v), function () { state.selected[f.key].delete(v); });
            });
        });
        if (state.priceMin > 0 || state.priceMax < PRICE_CEIL) {
            add('價格：$' + fmtMoney(state.priceMin) + ' – $' + fmtMoney(state.priceMax), function () {
                state.priceMin = 0; state.priceMax = PRICE_CEIL;
            });
        }
    }

    function renderPager(total, pageCount, start, shown) {
        $('#pagerInfo').textContent = total
            ? '第 ' + (start + 1) + '–' + (start + shown) + ' 筆，共 ' + fmtMoney(total) + ' 筆'
            : '共 0 筆';
        var box = $('#pages');
        box.innerHTML = '';
        if (pageCount <= 1) return;

        function btn(label, page, opts) {
            opts = opts || {};
            var b = document.createElement('button');
            b.type = 'button';
            b.innerHTML = label;
            if (opts.disabled) b.disabled = true;
            if (opts.cur) { b.classList.add('cur'); b.setAttribute('aria-current', 'page'); }
            b.addEventListener('click', function () {
                state.page = page; update();
                $('.table-card').scrollIntoView({ behavior: 'smooth', block: 'start' });
            });
            box.appendChild(b);
        }
        btn('‹', state.page - 1, { disabled: state.page === 1 });
        var pages = [];
        for (var p = 1; p <= pageCount; p++) {
            if (p === 1 || p === pageCount || Math.abs(p - state.page) <= 1) pages.push(p);
            else if (pages[pages.length - 1] !== '…') pages.push('…');
        }
        pages.forEach(function (p) {
            if (p === '…') { var s = document.createElement('span'); s.textContent = '…'; s.style.padding = '6px 4px'; box.appendChild(s); }
            else btn(String(p), p, { cur: p === state.page });
        });
        btn('›', state.page + 1, { disabled: state.page === pageCount });
    }

    $('#pageSize').addEventListener('change', function (e) {
        state.pageSize = Number(e.target.value);
        state.page = 1;
        update();
    });

    /* ---------- 複製型號 ---------- */
    var toastEl = $('#toast'), toastTimer;
    function toast(msg) {
        toastEl.textContent = msg;
        toastEl.classList.add('show');
        clearTimeout(toastTimer);
        toastTimer = setTimeout(function () { toastEl.classList.remove('show'); }, 1600);
    }
    function filterByType(t) {
        var s = state.selected.type;
        if (s.size === 1 && s.has(t)) s.clear(); else { s.clear(); s.add(t); }
        state.page = 1;
        update();
    }
    tbody.addEventListener('keydown', function (e) {
        var tg = e.target.closest && e.target.closest('.tag');
        if (tg && (e.key === 'Enter' || e.key === ' ')) {
            e.preventDefault();
            filterByType(tg.closest('tr').dataset.type);
        }
    });
    tbody.addEventListener('click', function (e) {
        var star = e.target.closest('.star');
        if (star) { toggleFav(star.closest('tr')); return; }
        var tg = e.target.closest('.tag');
        if (tg) { filterByType(tg.closest('tr').dataset.type); return; }
        var b = e.target.closest('.copy');
        if (!b) return;
        var text = b.dataset.copy;
        function fallback() {
            var ta = document.createElement('textarea');
            ta.value = text; document.body.appendChild(ta); ta.select();
            try { document.execCommand('copy'); toast('已複製：' + text); } catch (err) { toast('複製失敗'); }
            document.body.removeChild(ta);
        }
        if (navigator.clipboard && navigator.clipboard.writeText) {
            navigator.clipboard.writeText(text).then(function () { toast('已複製：' + text); }, fallback);
        } else fallback();
    });

    /* ---------- 主題切換 / 回到頂端 ---------- */
    $('#themeBtn').addEventListener('click', function () {
        var next = document.documentElement.getAttribute('data-theme') === 'dark' ? 'light' : 'dark';
        document.documentElement.setAttribute('data-theme', next);
        try { localStorage.setItem('hdd-theme', next); } catch (e) {}
    });

    var toTop = $('#toTop');
    window.addEventListener('scroll', function () { toTop.classList.toggle('show', window.scrollY > 500); }, { passive: true });
    toTop.addEventListener('click', function () { window.scrollTo({ top: 0, behavior: 'smooth' }); });

    /* ---------- 收藏按鈕 / 匯出 / 分享 / 密度 ---------- */
    function renderFavBtn() {
        var btn = $('#favBtn');
        var n = data.filter(function (r) { return favs.has(r.key); }).length;
        $('.count', btn).textContent = n;
        btn.classList.toggle('primary', state.favOnly);
        btn.setAttribute('aria-pressed', state.favOnly ? 'true' : 'false');
    }
    $('#favBtn').addEventListener('click', function () {
        state.favOnly = !state.favOnly;
        state.page = 1;
        update();
        if (state.favOnly && !filtered.length) toast('還沒有收藏，點列左側的 ☆ 加入');
    });

    function copyText(text, msg) {
        function fallback() {
            var ta = document.createElement('textarea');
            ta.value = text; document.body.appendChild(ta); ta.select();
            try { document.execCommand('copy'); toast(msg); } catch (err) { toast('複製失敗'); }
            document.body.removeChild(ta);
        }
        if (navigator.clipboard && navigator.clipboard.writeText) {
            navigator.clipboard.writeText(text).then(function () { toast(msg); }, fallback);
        } else fallback();
    }
    $('#shareBtn').addEventListener('click', function () { writeHash(); copyText(location.href, '已複製連結（含目前篩選條件）'); });

    function csvCell(v) {
        v = (v == null) ? '' : String(v);
        return /[",\n]/.test(v) ? '"' + v.replace(/"/g, '""') + '"' : v;
    }
    $('#csvBtn').addEventListener('click', function () {
        var head = ['種類', '品牌', '容量(TB)', '系列', '快取(MB)', '型號', '轉速RPM', '保固(年)', '價格', '每TB價'];
        var lines = [head.map(csvCell).join(',')];
        filtered.forEach(function (r) {
            lines.push([r.type, r.brand, r.sizeS, r.series, r.cache, r.model, r.rpmS, r.warranty, r.price, r.cp].map(csvCell).join(','));
        });
        var blob = new Blob(['﻿' + lines.join('\r\n')], { type: 'text/csv;charset=utf-8' });
        var a = document.createElement('a');
        a.href = URL.createObjectURL(blob);
        a.download = 'hdd-' + new Date().toISOString().slice(0, 10) + '.csv';
        document.body.appendChild(a); a.click(); a.remove();
        setTimeout(function () { URL.revokeObjectURL(a.href); }, 1000);
        toast('已匯出 ' + filtered.length + ' 筆');
    });

    function setDensity(compact) {
        document.body.classList.toggle('compact', compact);
        try { localStorage.setItem('hdd-density', compact ? '1' : '0'); } catch (e) {}
    }
    try { setDensity(localStorage.getItem('hdd-density') === '1'); } catch (e) {}
    $('#densityBtn').addEventListener('click', function () { setDensity(!document.body.classList.contains('compact')); });

    /* ---------- 篩選條件寫入 / 讀取網址 hash（可分享） ---------- */
    function writeHash() {
        var p = new URLSearchParams();
        if (state.q) p.set('q', state.q);
        FILTERS.forEach(function (f) {
            state.selected[f.key].forEach(function (v) { p.append('f_' + f.key, v); });
        });
        if (state.priceMin > 0) p.set('pmin', state.priceMin);
        if (state.priceMax < PRICE_CEIL) p.set('pmax', state.priceMax);
        if (state.sortKey) { p.set('sort', state.sortKey); p.set('dir', state.sortDir); }
        if (state.favOnly) p.set('fav', '1');
        if (state.pageSize !== 50) p.set('ps', state.pageSize);
        if (state.page > 1) p.set('page', state.page);
        var h = p.toString();
        try { history.replaceState(null, '', location.pathname + location.search + (h ? '#' + h : '')); } catch (e) {}
    }

    function readHash() {
        var h = location.hash.replace(/^#/, '');
        if (!h) return;
        var p = new URLSearchParams(h);
        if (p.get('q')) { state.q = p.get('q'); qInput.value = state.q; }
        FILTERS.forEach(function (f) {
            p.getAll('f_' + f.key).forEach(function (v) { state.selected[f.key].add(v); });
        });
        var pmin = toNum(p.get('pmin')), pmax = toNum(p.get('pmax'));
        if (pmin != null) state.priceMin = Math.max(0, Math.min(pmin, PRICE_CEIL));
        if (pmax != null) state.priceMax = Math.max(state.priceMin, Math.min(pmax, PRICE_CEIL));
        var sk = p.get('sort');
        if (sk && NUM_MAP[sk]) { state.sortKey = sk; state.sortKind = 'num'; state.sortDir = p.get('dir') === 'desc' ? 'desc' : 'asc'; }
        else if (sk && ['type', 'brand', 'series', 'model'].indexOf(sk) > -1) { state.sortKey = sk; state.sortKind = 'text'; state.sortDir = p.get('dir') === 'desc' ? 'desc' : 'asc'; }
        if (p.get('fav') === '1') state.favOnly = true;
        var ps = toNum(p.get('ps'));
        if (ps != null && [0, 25, 50, 100].indexOf(ps) > -1) { state.pageSize = ps; $('#pageSize').value = String(ps); }
        var pg = toNum(p.get('page'));
        if (pg != null && pg > 0) state.page = pg;
    }

    /* ---------- 初始化 ---------- */
    readHash();
    data.forEach(paintStar);
    update();
})();
</script>
</body>
</html>
